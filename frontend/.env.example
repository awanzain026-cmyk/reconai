# ReconAI frontend — copy to .env.local and fill in. NEVER commit .env.local.
# Default (no file needed) is http://127.0.0.1:8000 for local dev.
# After deploying the API, set this to the deployed backend URL, e.g.:
#   NEXT_PUBLIC_API_URL=https://your-app.fastapi.cloud
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000